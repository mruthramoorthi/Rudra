<body>
  <div class="container">
    <h1>500</h1>
    <p>Oops! Something went wrong.</p>
    <a class="button" href="/" tabindex="0"><i class="icon-home"></i> Go back to the login page, it's better.</a>
  </div>

  <script nonce="{{nonce}}">
    // Set focus to the anchor tag on page load
    document.addEventListener('DOMContentLoaded', function() {
  const button = document.querySelector('a.button');
  if (button) {
    button.focus();
  }
});
  </script>
</body>
