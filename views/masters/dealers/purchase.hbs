{{> form }}
<div class="addcssfortable1">
    <label for="" style="font-size: large;font-weight:800;">Pure : <label id='Pure' style="color:red;">0</label></label>
    <input type="hidden" name="Pure_balance" id="Pure_balance" value="0">
    {{selectBox id="dealer" options='nd:Dealers'}}
    {{selectBox id="metals" options='nd:Metal'}}
    <label for="" style="font-size: large;font-weight:800;">Cash : <label id='Cash' style="color:red;">0</label></label>
    <input type="hidden" name="Cash_balance" id="Cash_balance" value="0">
</div>
<div class="vietnam">
    <div class="snowdiv">
        <div class="addcssfortable">
            {{selectBox id="counter" options='nd:Counter'}}
            {{selectBox id="product" options='nd:Category'}}
            {{selectBox id="typeofjewel" options='nd:Jewel Type'}}
            {{selectBox id="subtype" options='nd:Sub Type'}}
