        if(row.querySelector(`#mc_status-${rowId}`).value==="pcs" && check_sts.checked)
            document.getElementById("gramorpcs").click();
        Sv("totalstoneweight", row.querySelector(`#totalstoneweight-${rowId}`).value);
        Sv("totalstoneprice", row.querySelector(`#totalstoneprice-${rowId}`).value);
        Sv("noofstones", row.querySelector(`#noofstones-${rowId}`).value);
        Sv("caratsize", row.querySelector(`#caratsize-${rowId}`).value);
        Sv("caratprice", row.querySelector(`#caratprice-${rowId}`).value);
        Sv("certificate", row.querySelector(`#certificate-${rowId}`).value);
        Sv("labour", row.querySelector(`#labour-${rowId}`).value);
        Sv("extra", row.querySelector(`#extra-${rowId}`).value);
        Sv("hallmark", row.querySelector(`#hallmark-${rowId}`).value);
        Sv("gst", row.querySelector(`#gst-${rowId}`).value);
        Sv("rowedit", rowId);
        scrollToElementById("form-for-get-input");
        // Set editingRow to this row
        editingRow = row;
        row.remove();
        cashCalc()
        pureCalc()
        const profilePic = row.querySelector(`#imgpath_photo-${rowId}`).value;
        const imagePathParts = profilePic.split("[pics~pics]").filter(item => item.trim() !== "");
        // Loop through the path parts and generate the <img> tags
        imagePathParts.forEach(item => {
            loadImg("photo", item);
        });
    }

    if (target.classList.contains("delete-icon")) {
        // Delete functionality
        const row = document.getElementById("tr" + rowId);
        row.remove();

        // Remove the rowId from the allrowid input
        removeRowId(rowId);
        buy_with_cash();
    }
    // Refresh the serial numbers
    refreshSerialNumbers();
});

// Remove the rowId from the allrowid hidden input
function removeRowId(rowId) {
    const allRowIdsInput = document.getElementById("allrowid");
    let allRowIds = allRowIdsInput.value ? allRowIdsInput.value.split(",") : [];
    allRowIds = allRowIds.filter(id => id !== rowId);  // Remove the rowId
    allRowIdsInput.value = allRowIds.join(",");  // Update the hidden input
}

// Refresh the serial numbers
function refreshSerialNumbers() {
    const tableBody = document.getElementById("purchase-adder");
    const rows = tableBody.querySelectorAll("tr");
    
    rows.forEach((row, index) => {
        const serialCell = row.querySelector("td:first-child");
        if (serialCell) {
            serialCell.textContent = index + 1;  // Update the serial number
        }
    });
}

