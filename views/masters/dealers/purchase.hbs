        Sv("waste", row.querySelector(`#waste-${rowId}`).value);
        Sv("mc", row.querySelector(`#mc-${rowId}`).value);
        const check_sts = document.getElementById("gramorpcs");
        if(row.querySelector(`#mc_status-${rowId}`).value==="gram" && !check_sts.checked)
