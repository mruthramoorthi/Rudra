    </div>
</div>
<div class="snowdiv addjust">
    <center>
        <table class="table-bordered"><thead><tr><th>S.no</th><th>Counter</th><th>Category</th><th>Jeweltype</th><th>Subtype</th><th>Pcs</th><th>Weight</th><th>Purity</th><th>Waste</th><th>Mc</th><th>Stone Weight</th><th>Stone Price</th><th>No Of Stones</th><th>Carat Size</th><th>Carat Price</th><th>Certificate Chrg</th><th>Labour Chrg</th><th>Extra Chrg</th><th>Hallmark Chrg</th><th>GST</th><th>GST Price</th><th>Pure</th><th>Cash</th><th>Action</th></tr></thead><tbody id="purchase-adder"></tbody></table>
