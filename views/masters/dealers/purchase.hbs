            {{imageUpload id="photo" noncei=nonce placeholder="Jewels Photo"}}
        </div>
    </div>
    <div class="snowdiv">
        <div class="addcssfortable">
            {{createInput type="number" id="totalstoneweight" placeholder="Total Stn Wt" othersForDiv="pcswt2"}}
            {{createInput type="number" id="totalstoneprice" placeholder="Total Stn rt" othersForDiv="pcswt2"}}
            {{createInput type="number" id="noofstones" placeholder="Stn nos" othersForDiv="pcswt2"}}
            {{createInput type="number" id="caratsize" placeholder="Ct Size" othersForDiv="pcswt2"}}
            {{createInput type="number" id="caratprice" placeholder="Ct Price" othersForDiv="pcswt2"}}
            {{createInput type="number" id="certificate" placeholder="Cert Chrg" othersForDiv="pcswt2"}}
            {{createInput type="number" id="labour" placeholder="Lab Chrg" othersForDiv="pcswt2"}}
            {{createInput type="number" id="extra" placeholder="Ex Chrg" othersForDiv="pcswt2"}}
            {{createInput type="number" id="hallmark" placeholder="HM Chrg" othersForDiv="pcswt2"}}
            {{createInput type="number" id="gst" placeholder="gst%" othersForDiv="pcswt2"}}
            <input type="hidden" name="gstprice" id="gstprice" value="0">
        </div><br>
        <div class="addcssfortable1">
            <label for="" style="font-size: large;font-weight:800;">Pure : <label id='Purep' style="color:blue;">0</label></label>
            <input type="hidden" name="Pure_purchase" id="Pure_purchase" value="0">
            <button type="button" id="add">Add</button>
            <button type="button" id="refresh">Refresh</button>
            <label for="" style="font-size: large;font-weight:800;">Cash : <label id='Cashp' style="color:blue;">0</label></label>
            <input type="hidden" name="Cash_purchase" id="Cash_purchase" value="0">
