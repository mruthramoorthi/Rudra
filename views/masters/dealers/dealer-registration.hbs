<style>
    
.display-f{
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
}

.center{
  margin: 0 auto;
  display: block;
}

#cancelButton{
    background-color: red;
    color: white;
    display: none;
}
    </style>
{{> header }}
{{> navbar }}
{{> form }}
<div class="snowdiv">
    <div class="display-f">
        {{selectBox id="metals" options='nd:Metal'}}
        {{createInput type="text" id="companyname" placeholder="Company Name"}}
        {{createInput type="text" id="gstin" placeholder="GST.no"}}
        {{createInput type="text" id="dealername" placeholder="Dealer Name"}}
        {{createInput type="text" id="dealercode" placeholder="Dealer Code"}}
        {{createInput type="text" id="address" placeholder="Address"}}
        {{createInput type="number" id="primaryph" placeholder="primaryph Phone"}}
        {{createInput type="number" id="secondaryph" placeholder="Secondary Phone"}}
        {{createInput type="number" id="accountnum" placeholder="Account Number"}}
        {{createInput type="text" id="mailid" placeholder="Email ID"}}
        {{selectBox id="openinginamount" options='nd:Opening Amount In,cr:CR,dr:DR'}}
        {{createInput type="number" id="amount" placeholder="Amount"}}
        {{selectBox id="openinginweight" options='nd:Opening Weight In,cr:CR,dr:DR'}}
        {{createInput type="number" id="weight" placeholder="Weight"}}
        <input type="hidden" id="uniquekey" name="uniquekey">
        <div class="display-f">
            {{selectBox id="state" options='nd:State'}}
            {{selectBox id="district" options='nd:District'}}
        </div>
        {{imageUpload id="photo" noncei=nonce placeholder="Dealer Photo"}}
        {{imageUpload id="proof" noncei=nonce placeholder="Visiting Card"}}
    </div>
    <div class="display-f">
        <button id="saveButton" class="center" type="button">Save</button>
        <button id="cancelButton" class="center" type="button">Cancel</button>
        {{#if (checkingRights data=rights action="print")}}
        <button id="pdfBtns" type="button">Print</button>
        {{/if}}
    </div>
</div>
{{> formend }}
{{> view }}
{{#if (checkingRights data=rights action="view")}}
<div id="lazy-content">
</div>
<div id="loading">
</div>
{{/if}}
{{> viewend }}

{{> dtb }}
<script nonce="{{nonce}}">
     document.addEventListener("DOMContentLoaded", () => {
        selectLoad('state', '/dealer-registration/loadState', content = 'application/json', undefined);
        selectLoad('metals', '/dealer-registration/metal', content = 'application/json', undefined);
        document.getElementById('state').addEventListener('change', function(event) {
            selectLoad('district', '/dealer-registration/loadDistrict', content = 'application/json', event.target.value);
        });
        let thead = "<th>S.no</th><th>company</th><th>Dealer</th><th>phone</th><th>state</th><th>District</th><th>Action</th>";
        let tfoot = "<td colspan='6'></td>";
        if({{checkingRights data=rights action="view"}})
        fetchTableData('content', '1000', '1', 'content', '', '/dealer-registration/select', '50vh', 'lazy-content', undefined, thead, tfoot);

        document.getElementById("saveButton").addEventListener("click", () => {
            const formData=getFormData();
            backEndCall(undefined, "/dealer-registration/insert", "POST", undefined, formData);
        });

        document.getElementById("cancelButton").addEventListener("click", () => {
            reloadSite();
        });
        document.addEventListener("click", (event) => {
            const clickedId = event.target.id;
            if(event.target.classList=="edit-icon")
            {
                debugger;
                let userDatas = JSON.parse(document.getElementById(clickedId).getAttribute('datas'));
                Sv("companyname",userDatas.company);
                Ss("metals",userDatas.metal);
                Sv("openinginamount",userDatas.openingamount);
                Sv("amount",userDatas.amount);
                Sv("openinginweight",userDatas.openingweight);
                Sv("weight",userDatas.weight);
                Sv("mailid",userDatas.email);
                Sv("accountnum",userDatas.accountnumber);
                Sv("dealername",userDatas.dealername);
                Sv("dealercode",userDatas.code);
                Sv("address",userDatas.address);
                Sv("primaryph",userDatas.primaryph);
                Sv("secondaryph",userDatas.secondaryph);
                Sv("gstin",userDatas.gstin);
                Sv("uniquekey",userDatas.uniqueid);
                Ss("state",userDatas.state);
                setTimeout(() => {
                Ss("district",userDatas.city);
                },500);
                const imagePathParts1 = userDatas.photo.split("[pics~pics]").filter(item => item.trim() !== "");
                // Loop through the path parts and generate the <img> tags
                imagePathParts1.forEach(item => {
                    loadImg("photo", item);
                });
                const imagePathParts = userDatas.proof.split("[pics~pics]").filter(item => item.trim() !== "");
                // Loop through the path parts and generate the <img> tags
                imagePathParts.forEach(item => {
                    loadImg("proof", item);
                });
                Si("saveButton", "Update");
                document.getElementById('cancelButton').style.display="block";
                document.dispatchEvent(edit_event);
            }
            if(event.target.classList=="delete-icon")
            {
                const deleteId = document.getElementById(clickedId).getAttribute('uniquekey');
                deleteKey = JSON.stringify({uniquekey: deleteId});
                const userConfirmed = window.confirm("Are you sure you want to delete this item?");
                if(userConfirmed)
                backEndCall(undefined, "/dealer-registration/delete", "POST", undefined, deleteKey);
            }
        });
     });
</script>
{{> footer }}