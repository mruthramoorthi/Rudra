<style>
.flex-box{
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
}
.customer_card{
    box-shadow: rgba(60, 64, 67, 0.3) 0px 1px 2px 0px, rgba(60, 64, 67, 0.15) 0px 2px 6px 2px;
    border-radius: 10px;
    padding: 10px;
    display: none;
}
.savings-profile{
    width: 75px;
}
.address{
    width: 250px;
}

</style>
{{> header }}
{{> navbar }}
{{> form }}
<div class="snowdiv">
    
    <div class="flex-box">
        <div>
            {{createInput type="text" id="cnumber" placeholder="Search Phone"}}
            {{createInput type="text" id="cname" placeholder="Search Name"}}
            <center><button type="button" id="search_i" name="search_i">Search</button></center>
        </div>
        <div>
            {{selectBox id="customer" options='nd:Customer'}}
            <br>
            <div class="flex-box">
                {{selectBox id="group" options='nd:Group'}}
            </div>
        </div>
        <div class="customer_card">
            {{createInput type="text" id="customername" placeholder="Customer Name"}}
            <div id="customer_details">
            </div>
        </div>
    </div><br>
    <div class="flex-box">
        {{createInput type="text" id="barcode" placeholder="Bar Code"}}
        {{createInput type="text" id="chitnumber" placeholder="Savings Count"}}
        {{createInput type="number" id="howmany" placeholder="Month"}}
    </div>
    <div id="months" class="flex-box">
    </div>
    <input type="hidden" name="uniquekey" id="uniquekey" value="">
    <input type="hidden" name="savingnumbers" id="savingnumbers" value="">
    <input type="hidden" name="savingcount" id="savingcount" value="">
    <br>
    <center><button type="button" id="add" name="add">Add</button></center>
</div>
{{> formend }}
{{> view }}
{{#if (checkingRights data=rights action="view")}}
    <div id="lazy-content">
    </div>
    <div id="loading">
    </div>
{{/if}}
{{> viewend }}

{{> dtb }}
<script nonce="{{nonce}}">
    document.addEventListener("DOMContentLoaded", () => {
        let thead = "<th>S.no</th><th>Savings Number</th><th>Savings Count</th><th>Group</th><th>Name</th><th>Phone</th><th>Due</th><th>Month</th><th>Total</th><th>Action</th>";
        let tfoot = "<td colspan='9'></td>";
        if ({{checkingRights data=rights action="view"}})
        fetchTableData('content', '1000', '1', 'content', '', '/savings-opening/select', '50vh', 'lazy-content', undefined, thead, tfoot);
        selectLoad('group', '/savings-opening/group', content = 'application/json', undefined);
        document.addEventListener("keyup", (event) => {
            if(event.target.id=="howmany")
            {
                let html = '';
                for(let i=1; i<=Val("howmany"); i++)
                    html += createInputElement({type:"date", id:"date_"+i, placeholder:"Date "+i});
                Si("months", html)
            }
        });
        document.addEventListener("click", (event) => {
            if(event.target.classList=="delete-icon")
            {
                const uniquekey = document.getElementById(event.target.id).getAttribute('uniquekey');
                const deleteKey = JSON.stringify({uniquekey});
                const userConfirmed = window.confirm("Are you sure you want to delete this item?");
                if(userConfirmed)
                backEndCall(undefined, "/savings-opening/delete", "POST", undefined, deleteKey);
            }
            if(event.target.classList=="edit-icon")
            {
                scrollToElementById("form-for-get-input");
                const datas = Val(event.target.id,"datas");
                const dates = Val(event.target.id,"dates").split("[dd]");
                Sv("cnumber",datas["ph1"]);
                setTimeout(()=>{
                    Ss("customer",datas["id"]+"[r~12]"+datas["name"]);
                },500);
                setTimeout(()=>{
                    Sv("customername",datas["savingname"]);
                },1000);
                Ss("group",datas["schemecode"]);
                Sv("uniquekey",datas["uniqueid"]);
                Sv("barcode",datas["savings_number"]);
                Sv("chitnumber",datas["savings_count"]);
                Sv("savingnumbers",datas["savings_number"]);
                Sv("savingcount",datas["savings_count"]);
                Sv("howmany",datas["ob"]);
                handleEvent("howmany", "keyup");
                document.getElementById("search_i").click();
                setTimeout(()=>{
                    for(let i=0; i<dates.length; i++)
                    {
                        Sv("date_"+parseInt(i+1), rawDateFormat(dates[i], "ymd", "-"));
                    }
                }, 1000);
                document.dispatchEvent(edit_event);
            }
        });
        document.getElementById("customer").addEventListener("change", () => {
            const formData=getFormData();
            backEndCall("show_details_of_customer", "/savings-opening/fetchDetails", "POST", undefined, formData);
        });
        document.getElementById("search_i").addEventListener("click", () => {
            const formData=getFormData();
            selectLoad('customer', '/savings-opening/customer', content = 'application/json', formData);
        });
    });
    
    document.getElementById("add").addEventListener("click", () => {
        const formData=getFormData();
        backEndCall(undefined, "/savings-opening/insert", "POST", undefined, formData);
    });
    function selectLoad_customer(msg)
    {
        // alert(msg.data);
    }
    function backEndCall_show_details_of_customer(msg)
    {
        debugger;
        const datas = msg.response[0];
        let design = "";
        if(datas)
        {
            design = `<div class='flex-box'>
                        <div>
                            <img src='/images/profile.png' class='savings-profile'>
                        </div>
                        <div>
                            <label>${caps(datas.name)}</label>
                            <br>
                            <label>${datas.primaryphonenumber}, ${datas.secondaryphonenumber}</label>
                            <br>
                            <label class='address'>${datas.address}</label>
                        </div>
                        <input type="hidden" name="ph1" id="ph1" value="${datas.primaryphonenumber}">
                        <input type="hidden" name="ph2" id="ph2" value="${datas.secondaryphonenumber}">
                        <input type="hidden" name="address" id="address" value="${datas.address}">
                    </div>`;
                    Sv("customername",datas.name);
                showClass("customer_card");
        }
        else
            h("customer_card");
        document.getElementById("customer_details").innerHTML = design;
    }
</script>
{{> footer }}