<style>
    #join_op{
        display: none;
    }
    .addcssfortable1{
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: space-around;
        align-items: center;
    }
    #search{
        padding: 5px;
        border-radius: 50px !important;
    }
    #search-img{
        width: 30px;
    }
    #search-div{
        display: flex;
        gap: 5px;
        align-items: center;
    }
    .jewel-pic{
        width: 50px; border-radius: 51%; padding: 2px; object-fit: cover; height: 50px;
    }
    .jewel-detail-div{
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .tagged-jewel {
        width: max-content;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #f9f9f9;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        margin-bottom: 15px;
        font-family: Arial, sans-serif;
    }
    .tagged-jewel-title{
        font-weight: 800;
        color: royalblue;
    }
    .jwl-qty{
        display: flex;
        gap: 2px;
    }
    .pcswt{
        width: 90px !important;
    }
    .date-time{
        width: 120px !important;
    }
    .lotcode{
        background: red;
        color: white;
        font-weight: 800;
        padding: 2px 5px;
        border-radius: 50%;
    }
</style>
{{> header }}
{{> navbar }}
{{> form }}
<div class="snowdiv addcssfortable">
    <div class="addcssfortable1">
        {{selectBox id="counter" options='nd:Counter'}}
        {{selectBox id="product" options='nd:Category'}}
        {{selectBox id="typeofjewel" options='nd:Jewel Type'}}
        {{selectBox id="subtype" options='nd:Sub Type'}}
        {{selectBox id="lotno" options='nd:Lot'}}
        {{selectBox id="alltags" options='nd:Tags'}}
        <div id="search-div">
            {{createInput type="text" id="tag" placeholder="Tag"}}
            <button type="button" id="search"><img src="https://cdn-icons-png.flaticon.com/512/3686/3686896.png" alt="" id="search-img" srcset=""></button>
        </div>
    </div>
    <div id="tagged"></div><br>
    <div class="addcssfortable1">
        {{selectBox id="counterto" options='nd:Counter'}}
        {{selectBox id="productto" options='nd:Category'}}
        {{selectBox id="typeofjewelto" options='nd:Jewel Type'}}
        {{selectBox id="subtypeto" options='nd:Sub Type'}}
    </div>
    <br>
    <center><button type="button" id="saveDet">Save</button></center>
</div>
{{> formend }}
{{> view }}
{{#if (checkingRights data=rights action="view")}}
<div id="lazy-content">
</div>
<div id="loading">
</div>
{{/if}}
{{> viewend }}

{{> dtb }}
<script nonce="{{nonce}}">
    document.addEventListener("DOMContentLoaded", () => {
        let thead = "<th>S.no</th><th>Tag</th><th>Jewel</th><th>Quatity</th><th>Action</th>";
        let tfoot = "";
        fetchTableData('content', '1000', '1', 'content', '', '/stock-adjustment/select', '50vh', 'lazy-content', undefined, thead, tfoot, "tagtable");
        selectLoad('counter', '/stock-adjustment/counter', content = 'application/json', undefined);
        selectLoad('counterto', '/stock-adjustment/counterTo', content = 'application/json', undefined);
        document.getElementById('counterto').addEventListener('change', function(event) {    
            selectLoad('productto', '/stock-adjustment/loadCateTo', content = 'application/json', event.target.value);
        });
        document.getElementById('productto').addEventListener('change', function(event) {
            selectLoad('typeofjewelto', '/stock-adjustment/loadJewelTo', content = 'application/json', event.target.value);
        });
        document.getElementById('typeofjewelto').addEventListener('change', function(event) {
            selectLoad('subtypeto', '/stock-adjustment/subtypeTo', content = 'application/json', event.target.value+"[w~12]"+Val("productto"));
        });
        document.getElementById('counter').addEventListener('change', function(event) {
            selectLoad('product', '/stock-adjustment/loadCate', content = 'application/json', event.target.value);
        });
        document.getElementById('lotno').addEventListener('change', function(event) {
            selectLoad('alltags', '/stock-adjustment/allTag', content = 'application/json', event.target.value);
        });
        document.getElementById('product').addEventListener('change', function(event) {
            selectLoad('typeofjewel', '/stock-adjustment/loadJewel', content = 'application/json', event.target.value);
        });
        document.getElementById('typeofjewel').addEventListener('change', function(event) {
            selectLoad('subtype', '/stock-adjustment/subType', content = 'application/json', event.target.value+"[w~12]"+Val("product"));
        });
        document.getElementById('subtype').addEventListener('change', function(event) {
            const counter = Val("counter");
            const product = Val("product");
            const jeweltype = Val("typeofjewel");
            const subtype = Val("subtype");
            const allData = JSON.stringify({counter,product,jeweltype,subtype});
            selectLoad('lotno', '/stock-adjustment/lot', content = 'application/json', allData);
        });
        document.getElementById('alltags').addEventListener('change', function(event) {
            Sv("tag",event.target.value);
            searchable_tag()
        });
        document.getElementById('search').addEventListener('click', function(event) {
            searchable_tag()
        });
        document.addEventListener('click', function(event) {
            const clickedId = event.target.id;
            if(clickedId=="saveDet")
            {
                const formData=getFormData();
                backEndCall(undefined, "/stock-adjustment/saveDet", "POST", undefined, formData);
            }
            if(event.target.classList=="delete-icon")
            {
                const deleteId = document.getElementById(clickedId).getAttribute('uniquekey');
                const tag = document.getElementById(clickedId).getAttribute('tag');
                deleteKey = JSON.stringify({uniquekey: deleteId, tag});
                const userConfirmed = window.confirm("Are you sure you want to delete this item?");
                if(userConfirmed)
                    backEndCall(undefined, "/stock-adjustment/delete", "POST", undefined, deleteKey);
            }
        });
    });
    function searchable_tag()
    {
        const formData=getFormData();
        backEndCall("tag_details", "/stock-adjustment/tagDetails", "POST", undefined, formData);
    }
    function backEndCall_tag_details(msg)
    {
        Si("tagged","");
        if(msg.success)
        {
            Si("tagged",msg.html)
            selectLoad('joinlotno', '/stock-adjustment/lotJoin', content = 'application/json', undefined);
        }
    }
</script>
{{> footer }}