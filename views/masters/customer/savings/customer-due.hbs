<style>
    #transactions{
        display: none;
    }
.alignment {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
}
.see-transaction{
    font-style: italic;
    color: gray;
    font-size: larger;
}
.alert-saving{
    color: red;
}
.close-savings{
    color: white;
    background-color: red;
}
#saveButton{
    display: block;
    margin: 0 auto;
}
.savings-ele{
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
}
.paidalert{
    color: green;
    font-style: italic;
}
.nextdue{
    color: mediumblue;
    font-weight: 800;
    font-size: large;
}
#bankdiv{
    display: none;
    gap: 10px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
}
.close-badge{
    background: red;
    padding: 2px 10px;
    border-radius: 10px;
    color: white;
    width: 100px;
}
@keyframes blink {
  0% {
    opacity: 1;
  }
  50% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}

.blink {
    color: red;
  animation: blink 1s infinite;
}
.addcssfortable{
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
} 
.main-tabs{
    display: none;
}
</style>
{{> header }}
{{> navbar }}
{{> form }}
<div class="snowdiv addcssfortable">
  {{selectBox id="savingnum" options='nd:Savings Number'}}
</div>
<br>
{{#if (checkingRights data=rights action="view")}}
<div id="lazy-content">
</div>
<div id="loading">
</div>
{{/if}}
{{> formend }}
{{> view }}
{{> viewend }}

{{> dtb }}
<script nonce="{{nonce}}">
    document.addEventListener("DOMContentLoaded", () => {
        selectLoad('savingnum', '/customer-due/savings', content = 'application/json', undefined);
    });
    document.getElementById('savingnum').addEventListener('change', function(event) {
        const datai = event.target.value;
        const data = JSON.stringify({datai});
        // Call the fetchData function and wait for it to complete
        if ({{checkingRights data=rights action="view"}})
        fetchDivData('content', '1000', '1', 'content', '', '/customer-due/select', '50vh', 'lazy-content', data);
    });
    document.addEventListener('keyup', function(event) {
        if(event.target.id=="bank")
        {
            const balance = Val("realdue") - event.target.value;
            Sv("due",balance);
        }
    });
    document.addEventListener('click', function(event) {
        debugger
        if(event.target.id=="paid")
        {
            const formData=getFormData();
            const userConfirmed = window.confirm("Is this customer now paying their dues?");
            if(userConfirmed)
            backEndCall(undefined, "/customer-due/insert", "POST", undefined, formData);
        }
        if(event.target.id=="close")
        {
            const formData=getFormData();
            const userConfirmed = window.confirm("Is this customer now Close their Saving Scheme?");
            if(userConfirmed)
            backEndCall(undefined, "/customer-due/close", "POST", undefined, formData);
        }
        if(event.target.classList=="see-transaction")
        {
            if(document.getElementById("transactions").style.display=="none")
                s("transactions");
            else
                h("transactions");
        }
    });
    document.addEventListener('change', function(event) {
        if(event.target.id=="paymenttype")
        {
            if(event.target.value=="bank")
            {
                s("bankdiv","flex");
                selectLoad('banks', '/customer-due/bank', content = 'application/json', event.target.value);
                selectLoad('transactiontype', '/customer-due/transactionType', content = 'application/json', undefined);
                Sv("bank",Val("realdue"));
                Sv("due",0);
            }
            else if(event.target.value=="cash")
            {
                h("bankdiv");
                Sv("bank",0);
                Sv("due",Val("realdue"));
            }
        }
    });
</script>
{{> footer }}