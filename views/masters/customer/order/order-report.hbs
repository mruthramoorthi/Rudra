    <div class="display-flexing">
    {{createInput id="fdate" type="date" placeholder="From"}}
    {{createInput id="todate" type="date" placeholder="To"}}
    {{selectBox id="decide" options="nd: - Report on - ,1:allotment,2:non-allotment,3:delivered,4:cancelled"}}
