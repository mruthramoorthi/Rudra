function backEndCall_load_jewels(msg)
{
    refrshing();
    Sat("order-adder",'jewel'+msg.id,msg.html);
    Sv("addid",Val("addid")+msg.id+"[s~1]");
    final_calculation()
}
function backEndCall_load_price(msg)
{
    Sa("form-for-get-input","prices",msg.response);
}
function backEndCall_jewel_control(msg)
{
    if(msg.success)
    {
        const product = Val("product");
        const product_rate = valNum(Val(product));
        let rate = 0;
        if(msg.response.spltype!='nd' && msg.response.spltype)
            rate = msg.response.splprice;
        else
            rate = product_rate;
        const stonetotalweights = document.querySelectorAll('.stonetotalweights');
        let stonetotalweight = 0;
        // Loop through each element and add its value to the sum
        stonetotalweights.forEach(input => {
            stonetotalweight += parseFloat(input.value) || 0; // Convert value to float and add to sum (if it's a valid number)
        });
        const totalweight = parseFloat(valNum(Val("totalweight"))) -stonetotalweight;
        let min_w_gram = 0;
        let min_w_amount = 0;
        let min_w_perc = 0;
        if (msg.response.wastetype == "perc")
        {
            min_w_perc = msg.response.minwaste;
            min_w_gram = parseFloat(valNum(msg.response.minwaste / 100)) * parseFloat(valNum(totalweight));
            min_w_amount = parseFloat(valNum(min_w_gram)) * parseFloat(valNum(rate));
        }
        else if (msg.response.wastetype == "amt")
        {
            min_w_amount = parseFloat(valNum(msg.response.minwaste)) * parseFloat(valNum(totalweight));
        }
        let max_w_gram = 0;
        let max_w_amount = 0;
        let max_w_perc = 0;
        let w_read_only = "";
        let mc_read_only = "";
        if (msg.response.wastetype == "perc")
        {
            max_w_perc = msg.response.maxwaste;
            max_w_gram = parseFloat(valNum(msg.response.maxwaste / 100)) * parseFloat(valNum(totalweight));
            max_w_amount = parseFloat(valNum(max_w_gram)) * parseFloat(valNum(rate));
        }
        else if (msg.response.wastetype == "amt")
        {
            w_read_only = "readonly";
            max_w_amount = parseFloat(valNum(msg.response.maxwaste)) * parseFloat(valNum(totalweight));
        }
        let min_mc_gram = 0;
        let min_mc_amount = 0;
        let min_mc_perc = 0;
        if (msg.response.mctype == "perc")
        {
            min_mc_perc = msg.response.minmc;
            min_mc_gram = parseFloat(valNum(msg.response.minmc / 100)) * parseFloat(valNum(totalweight));
            min_mc_amount = parseFloat(valNum(min_mc_gram)) * parseFloat(valNum(rate));
        }
        else if (msg.response.mctype == "amt")
        {
            min_mc_amount = parseFloat(valNum(msg.response.minmc)) * parseFloat(valNum(totalweight));
        }
        let max_mc_gram = 0;
        let max_mc_amount = 0;
        let max_mc_perc = 0;
        if (msg.response.mctype == "perc")
        {
            max_mc_perc = msg.response.maxmc;
            max_mc_gram = parseFloat(valNum(msg.response.maxmc / 100)) * parseFloat(valNum(totalweight));
            max_mc_amount= parseFloat(valNum(max_mc_gram)) * parseFloat(valNum(rate));
        }
        else if (msg.response.mctype == "amt")
        {
            mc_read_only = "readonly";
            max_mc_amount= parseFloat(valNum(msg.response.maxmc)) * parseFloat(valNum(totalweight));
        }
        document.getElementById('notify-div').innerHTML='';
        Si("adjusters",`<div class="display-f adj"><label><b>Waste</b></label>
        <input type="hidden" name="minwastep" id="minwastep" value="${min_w_perc}"/>
        <input type="hidden" name="minwasteg" id="minwasteg" value="${min_w_gram}"/>
        <input type="hidden" name="minwastea" id="minwastea" value="${min_w_amount}"/>
        <input type="hidden" name="maxwastep" id="maxwastep" value="${max_w_perc}"/>
        <input type="hidden" name="maxwasteg" id="maxwasteg" value="${max_w_gram}"/>
        <input type="hidden" name="maxwastea" id="maxwastea" value="${max_w_amount}"/>
        <div><input type="number" name="wastep" id="wastep" class='adj-box range_adjusters ${w_read_only}' value="${max_w_perc}"/><label>.%</label></div>
        <div><input type="number" name="wasteg" id="wasteg" class='adj-box range_adjusters ${w_read_only}' value="${max_w_gram}"/><label>.G</label></div>
        <div><input type="number" name="wastea" id="wastea" class='adj-box range_adjusters' value="${max_w_amount}"/><label>./-</label></div></div>
            <input type='range' id='waste' name='waste' class='range_adjusters' step='1' ctype='${msg.response.wastetype}' minwaste='${min_w_perc}' maxwaste='${max_w_perc}' min='${min_w_amount}' max='${max_w_amount}' value='${max_w_amount}'>
            
            <div class="display-f adj"><label><b>MC</b></label>
            <input type="hidden" name="minmcp" id="minmcp" value="${min_mc_perc}"/>
            <input type="hidden" name="minmcg" id="minmcg" value="${min_mc_gram}"/>
            <input type="hidden" name="minmca" id="minmca" value="${min_mc_amount}"/>
            <input type="hidden" name="maxmcp" id="maxmcp" value="${max_mc_perc}"/>
            <input type="hidden" name="maxmcg" id="maxmcg" value="${max_mc_gram}"/>
            <input type="hidden" name="maxmca" id="maxmca" value="${max_mc_amount}"/>
            <div><input type="number" name="mcp" id="mcp" class='adj-box range_adjusters ${mc_read_only}' value="${max_mc_perc}"/><label>.%</label></div>
            <div><input type="number" name="mcg" id="mcg" class='adj-box range_adjusters ${mc_read_only}' value="${max_mc_gram}"/><label>.G</label></div>
            <div><input type="number" name="mca" id="mca" class='adj-box range_adjusters' value="${max_mc_amount}"/><label>./-</label></div></div>
            <input type='range' id='mc' name='mc' class='range_adjusters' step='1' ctype='${msg.response.mctype}' minmc='${min_mc_perc}' maxmc='${max_mc_perc}' min='${min_mc_amount}' max='${max_mc_amount}' value='${max_mc_amount}'>
            <input type="hidden" name="splprice" id="splprice" ctype='${msg.response.spltype}' value="${msg.response.splprice}"/>`);
    }
}
function range_adjusters(id)
{
    const waste = valNum(Val("waste"));
    const mc = valNum(Val("mc"));
    const wastep = valNum(Val("wastep"));
    const mcp = valNum(Val("mcp"));
    const wasteg = valNum(Val("wasteg"));
    const mcg = valNum(Val("mcg"));
    const wastea = valNum(Val("wastea"));
    const mca = valNum(Val("mca"));
    const waste_type = Val("waste","ctype");
    const mc_type = Val("mc","ctype");
    const product = Val("product");
    const product_rate = valNum(Val(product));
    const splprice = valNum(Val("splprice"));
    const spltype = Val("splprice","ctype");
    const totalweight = valNum(Val("totalweight"));
    const minwastep = money(valNum(Val("minwastep")),3,0);
    const minwasteg = money(valNum(Val("minwasteg")),3,0);
    const minwastea = money(valNum(Val("minwastea")),3,0);
    const maxwastep = money(valNum(Val("maxwastep")),3,0);
    const maxwasteg = money(valNum(Val("maxwasteg")),3,0);
    const maxwastea = money(valNum(Val("maxwastea")),3,0);
    const minmcp = money(valNum(Val("minmcp")),3,0);
    const minmcg = money(valNum(Val("minmcg")),3,0);
    const minmca = money(valNum(Val("minmca")),3,0);
    const maxmcp = money(valNum(Val("maxmcp")),3,0);
    const maxmcg = money(valNum(Val("maxmcg")),3,0);
    const maxmca = money(valNum(Val("maxmca")),3,0);
    const stonetotalweights = document.querySelectorAll('.stonetotalweights');
    let stonetotalweight = 0;
    // Loop through each element and add its value to the sum
    stonetotalweights.forEach(input => {
        stonetotalweight += parseFloat(input.value) || 0; // Convert value to float and add to sum (if it's a valid number)
    });
    const weight = valNum(totalweight) - valNum(stonetotalweight);
    let rate = 0;
    if(spltype!='nd' && spltype)
        rate = splprice;
    else
        rate = product_rate;
    if(id=="waste" || id=="wastea")
    {
        let waste_gram = 0;
        let waste_percentage = 0;
        if(waste_type=="perc")
        {
            waste_gram = parseFloat(valNum(waste)) / parseFloat(valNum(rate));
            waste_percentage = (waste_gram / parseFloat(valNum(weight))) * 100;
        }
        Sv("wastep",money(waste_percentage,3,0));
        Sv("wasteg",money(waste_gram,3,0));
        if(id=="waste")
        Sv("wastea",money(waste,3,0));
        else
        Sv("waste",money(wastea,3,0));
    }
    if(id=="mc" || id=="mca")
    {
        let mc_gram = 0;
        let mc_percentage = 0;
        if(mc_type=="perc")
        {
            mc_gram = parseFloat(valNum(mc)) / parseFloat(valNum(rate));
            mc_percentage = (mc_gram / parseFloat(valNum(weight))) * 100;
        }
        Sv("mcp",money(mc_percentage,3,0));
        Sv("mcg",money(mc_gram,3,0));
        if(id=="mc")
        Sv("mca",money(mc,3,0));
        else
        Sv("mc",money(mca,3,0));
    }
    if(id=="mcp")
    {
        let mc_gram = 0;
        let mc_amount = 0;
        if(waste_type=="perc")
        {
            mc_gram = parseFloat(valNum(mcp / 100)) * parseFloat(valNum(weight));
            mc_amount = parseFloat(valNum(mc_gram)) * parseFloat(valNum(rate));
        }
        else
        {
            mc_amount = mc;
        }
        Sv("mc",money(mc_amount,3,0));
        Sv("mcg",money(mc_gram,3,0));
        Sv("mca",money(mc_amount,3,0));
    }
    if(id=="wastep")
    {
        let waste_gram = 0;
        let waste_amount = 0;
        if(waste_type=="perc")
        {
            waste_gram = parseFloat(valNum(wastep / 100)) * parseFloat(valNum(weight));
            waste_amount = parseFloat(valNum(waste_gram)) * parseFloat(valNum(rate));
        }
        else
        {
            waste_amount = waste;
        }
        Sv("waste",money(waste_amount,3,0));
        Sv("wasteg",money(waste_gram,3,0));
        Sv("wastea",money(waste_amount,3,0));
    }
    if(id=="mcg")
    {
        let mc_percentage = 0;
        let mc_amount = 0;
        if(waste_type=="perc")
        {
            mc_percentage = (mcg / weight) * 100;
            mc_amount = mcg * rate;
        }
        else
        {
            mc_amount = mc;
        }
        Sv("mc",money(mc_amount,3,0));
        Sv("mcp",money(mc_percentage,3,0));
        Sv("mca",money(mc_amount,3,0));
    }
    if(id=="wasteg")
    {
        let waste_percentage = 0;
        let waste_amount = 0;
        if(waste_type=="perc")
        {
            waste_percentage = (wasteg / weight) * 100;
            waste_amount = wasteg * rate;
        }
        else
        {
            waste_amount = mc;
        }
        Sv("waste",money(waste_amount,3,0));
        Sv("wastep",money(waste_percentage,3,0));
        Sv("wastea",money(waste_amount,3,0));
    }
    jewel_calculation()
}
