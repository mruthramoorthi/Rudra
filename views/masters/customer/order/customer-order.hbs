function stones_calculation(id)
{
    const ids = id.split("_")[1];
    if(ids)
    {
        const stone_price = parseFloat(valNum(Val("stp_"+ids)));
        const carat_size = valNum(Val("caratsize_"+ids));
        const carat_price = valNum(Val("caratprice_"+ids));
        const carat_total_price = parseFloat(carat_size) * parseFloat(carat_price);
        const total_stone_price = carat_total_price + stone_price;
        Sv("carattotalprice"+ids, money(carat_total_price,3,0));
        Sv("stonetotalprice"+ids, money(stone_price,3,0));
        Sv("stonestotalprice"+ids, money(total_stone_price,3,0));
        Si("total_carat_price"+ids, money(total_stone_price,3,1));
        jewel_calculation()
    }
}
