            const pdfBtn = document.getElementById(event.target.id);
            if ({{checkingRights data=rights action="print"}}) {
                openPDF("/customer-order/pdf","POST",{"id":pdfBtn.getAttribute("purchase")});
            }
        }
        if(event.target.classList=="edit-iconi")
        {
            const deleteId = document.getElementById(clickedId).getAttribute('uniquekey');
            deleteKey = JSON.stringify({uniquekey: deleteId});
            backEndCall("edit_jewels", "/customer-order/edit", "POST", undefined, deleteKey);
        }
        if(event.target.classList=="delete-iconi")
        {
            const deleteId = document.getElementById(clickedId).getAttribute('uniquekey');
            deleteKey = JSON.stringify({uniquekey: deleteId});
            const userConfirmed = window.confirm("Are you sure you want to delete this item?");
            if(userConfirmed)
                backEndCall(undefined, "/customer-order/delete", "POST", undefined, deleteKey);
        }
        if(event.target.classList=="exchangeFunction")
        {
            final_calculation();
        }
        if(event.target.classList=="stones-del")
        {
            final_calculation();
        }
    });
    
    let editingRow = null; // To keep track of the row being edited

    // Add event listener for the "Add" button to capture the input and add to the table
    document.getElementById("save").addEventListener("click", () => {
        const formData = getFormData();
        backEndCall(undefined,"/customer-order/insert","POST",undefined,formData);
    });
    document.getElementById("save_quot").addEventListener("click", () => {
        const formData = getFormData();
        backEndCall(undefined,"/customer-order/insert_quot","POST",undefined,formData);
    });    
    document.getElementById("add").addEventListener("click", () => {
        const formData = getFormData();
        backEndCall("load_jewels", "/customer-order/addJewel", "POST", undefined, formData);
    });

});
