function jewel_calculation()
{
    const product = Val("product");
    const product_rate = valNum(Val(product));
    const totalweight = valNum(Val("totalweight"));
    const waste = valNum(Val("waste"));
    const mc = valNum(Val("mc"));
    const splprice = valNum(Val("splprice"));
    const spltype = Val("splprice","ctype");
    const stonetotalweights = document.querySelectorAll('.stonetotalweights');
    let stonetotalweight = 0;
    // Loop through each element and add its value to the sum
    stonetotalweights.forEach(input => {
        stonetotalweight += parseFloat(input.value) || 0; // Convert value to float and add to sum (if it's a valid number)
    });
    const weight = valNum(totalweight) - valNum(stonetotalweight);
    let rate = 0;
    let jewel_rate = 0;
    if(spltype!='nd' && spltype)
    {
        rate = splprice;
        if(spltype=="gram")
        jewel_rate = parseFloat(valNum(rate)) * parseFloat(valNum(weight));
        else
        jewel_rate = parseFloat(valNum(rate));
    }
    else
    {
        rate = product_rate;
        jewel_rate = parseFloat(valNum(rate)) * parseFloat(valNum(weight));
    }
    const jewel_raw_Amount = jewel_rate;
    const stoneprice = document.querySelectorAll('.stonestotalprices');
    let stonetotalprice = 0;
    // Loop through each element and add its value to the sum
    stoneprice.forEach(input => {
        stonetotalprice += parseFloat(input.value) || 0; // Convert value to float and add to sum (if it's a valid number)
    });
    const total_jewel_amount = parseFloat(stonetotalprice) + parseFloat(mc) + parseFloat(waste) + parseFloat(jewel_raw_Amount);
    Si("jewel_price",money(total_jewel_amount,3,1));
    Sv("jewelamount",money(total_jewel_amount,3,0));
}
