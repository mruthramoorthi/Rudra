function jwl_range_adjusters(id)
{
    const ids = id.split("_");
    const waste = valNum(Val("waste_"+ids[1]));
    const mc = valNum(Val("mc_"+ids[1]));
    const wastep = valNum(Val("wastep_"+ids[1]));
    const mcp = valNum(Val("mcp_"+ids[1]));
    const wasteg = valNum(Val("wasteg_"+ids[1]));
    const mcg = valNum(Val("mcg_"+ids[1]));
    const wastea = valNum(Val("wastea_"+ids[1]));
    const mca = valNum(Val("mca_"+ids[1]));
    const waste_type = Val("waste_"+ids[1],"ctype");
