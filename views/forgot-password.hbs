{{> form }}
<div class="snowdiv addcssfortable">
    <center><h3>Change Password</h3></center>
    <br>
    <div id="otpverify" class="flexo">
        {{createInput type="number" id="phone" placeholder="Mobile No"}}
        <button type="button" id="sendotp" name="sendotp">Send</button>
    </div>
    <br>
    <hr>
