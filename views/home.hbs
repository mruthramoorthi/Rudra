        <textarea id="message" placeholder="Type your message here..."></textarea>
        <br><br>
        <button id="sendMessageBtn">Send Message</button>
    </div> --}}

{{!-- // Fetch QR code from server
        fetch('/qr')
            .then(response => response.json())
            .then(data => {
                if (data.qr) {
                    document.getElementById('qr').innerHTML = `<img src="https://api.qrserver.com/v1/create-qr-code/?data=${data.qr}" alt="QR Code" />`;
                }
            });

        // Once the client is ready, show the message form
        fetch('/qr')
            .then(response => response.json())
            .then(data => {
                if (data.qr === undefined) {
                    document.getElementById('message-form').style.display = 'block';
                }
            });

        // Send the message to the server
        document.getElementById('sendMessageBtn').addEventListener('click', function () {
            const phone = document.getElementById('phone').value;
            const message = document.getElementById('message').value;

            fetch('/send-message', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ to: `whatsapp:${phone}`, message })
            })
            .then(response => response.json())
            .then(data => {
                alert(data.message);
            })
            .catch(error => {
                console.error('Error:', error);
            });
        }); --}}

