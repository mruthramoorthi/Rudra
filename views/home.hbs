        body { font-family: Arial, sans-serif; }
        #qr-code { margin: 20px auto; text-align: center; }
        #sendMessageBtn { margin-top: 20px; padding: 10px 20px; background-color: #4CAF50; color: white; border: none; cursor: pointer; }
        #sendMessageBtn:disabled { background-color: #ddd; }
        .main-tabs{
            display: none !important;
        }
    </style>
